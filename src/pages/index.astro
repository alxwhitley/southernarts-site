---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { business } from "../data/business";

const mapsHref = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(business.address.full)}`;
---

<Layout
	title="Southern Dental Arts | Family & Cosmetic Dentist in Raleigh, NC"
	description="Independent family and cosmetic dental practice in Raleigh, NC. Known for how well we handle dental anxiety — patient, unhurried, and never pushy."
>
	<div class="bg-olive-soft/15 py-2 text-center text-sm text-olive-deep">
		Concept draft for internal review — copy and imagery are placeholders pending practice confirmation.
	</div>

	<Header />

	<main>
		<!-- ============ 2. HERO ============ -->
		<section class="container-page grid items-center gap-12 py-16 lg:grid-cols-2 lg:py-24">
			<div class="order-2 hero-settle lg:order-1">
				<h1 class="text-[clamp(2.25rem,4vw+1rem,3.75rem)] leading-[1.08]">
					The kind of dentist people stay with.
				</h1>
				<p class="measure mt-6 text-lg text-ink-muted">
					Southern Dental Arts is an independent practice in Raleigh. Family care and
					cosmetic dentistry, at a pace that leaves room for questions.
				</p>
				<div class="mt-8 flex flex-wrap gap-4">
					<a href="/book/" class="rounded-lg bg-gold-text px-7 py-3.5 font-semibold text-white shadow-soft transition hover:brightness-110">
						Book a visit
					</a>
					<a href={business.phone.href} class="rounded-lg border border-olive-deep px-7 py-3.5 font-semibold text-olive-deep transition hover:bg-olive-deep hover:text-white">
						Call {business.phone.display}
					</a>
				</div>
			</div>
			<div class="order-1 lg:order-2">
				<div class="relative aspect-4/5 overflow-hidden rounded-2xl bg-linear-to-br from-olive-soft/25 via-base to-gold-accent/15 shadow-lifted">
					<div class="absolute inset-0 flex items-end p-6">
						<span class="rounded-full bg-surface/90 px-4 py-2 text-xs font-medium text-ink-muted shadow-soft">
							Real photography of Dr. Staehling and the practice — pending
						</span>
					</div>
				</div>
			</div>
		</section>

		<!-- ============ 3. TRUST STRIP ============ -->
		<section class="border-y border-border bg-surface py-8">
			<div class="container-page flex flex-col items-center gap-6 text-center sm:flex-row sm:justify-between sm:text-left">
				<div class="flex items-center gap-3">
					<span class="flex text-gold-text" aria-hidden="true">
						{Array.from({ length: 5 }).map(() => <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 21 12 17.77 5.82 21 7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>)}
					</span>
					<p class="text-sm font-medium text-ink">
						{business.reviews.rating} stars &middot; {business.reviews.count} {business.reviews.source} reviews
					</p>
				</div>
				<div class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm font-medium tracking-wide text-ink-muted">
					<span>ADA</span>
					<span>AGD</span>
					<span>AACD</span>
					<span>NC Dental Society</span>
				</div>
			</div>
		</section>

		<!-- ============ 4. ANXIETY BLOCK ============ -->
		<section id="anxiety" class="bg-olive-deep py-20 text-white">
			<div class="container-page grid gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
				<div>
					<h2 class="text-white">What if you're nervous about the dentist?</h2>
					<p class="measure mt-6 text-white/85">
						Tell us before your appointment and we will plan around it. A first visit here
						starts with a conversation, not an instrument. Dr. Staehling walks through what
						he sees on your x-rays, explains what each option would involve, and tells you
						what can reasonably wait. Nothing is decided the same day unless you want it
						decided. Patients who have put off dental care for years are a regular part of
						the schedule here, and there is no lecture waiting for you when you come back.
						If you need to stop partway through, you say so and we stop.
					</p>
					<a href="/dental-anxiety/" class="mt-6 inline-block font-semibold text-gold-accent hover:underline">
						How we help nervous patients →
					</a>
				</div>
				<div class="aspect-square rounded-2xl bg-white/5 ring-1 ring-white/10">
					<div class="flex h-full items-end p-6">
						<span class="rounded-full bg-white/10 px-4 py-2 text-xs font-medium text-white/70">
							A calm treatment room, not a smiling face — photography pending
						</span>
					</div>
				</div>
			</div>
		</section>

		<!-- ============ 5. TWO-TIER SERVICE SPLIT ============ -->
		<section id="services" class="container-page py-20">
			<h2 class="text-center">Two ways people come to us.</h2>
			<div class="mt-10 grid gap-6 lg:grid-cols-2">
				<div class="rounded-2xl border border-border bg-surface p-8 shadow-soft">
					<h3>Family and preventive care</h3>
					<p class="mt-3 text-ink-muted">
						Cleanings, exams, and the restorative work that keeps a tooth in your mouth
						rather than replacing it. Children are welcome from their first visit.
					</p>
					<ul class="mt-6 flex flex-col gap-2 text-sm">
						<li><a href="/dental-cleanings/" class="text-gold-text hover:underline">Cleanings &amp; exams</a></li>
						<li><a href="/childrens-dentistry/" class="text-gold-text hover:underline">Children's dentistry</a></li>
						<li><a href="/dental-crowns-and-bridges/" class="text-gold-text hover:underline">Crowns &amp; bridges</a></li>
						<li><a href="/emergency-dentistry/" class="text-gold-text hover:underline">Emergency care</a></li>
					</ul>
					<a href="/family-dentistry/" class="mt-6 inline-block font-semibold text-olive-deep hover:underline">
						All family care →
					</a>
				</div>
				<div class="rounded-2xl border border-border bg-surface p-8 shadow-soft">
					<h3>Cosmetic dentistry</h3>
					<p class="mt-3 text-ink-muted">
						Changes to how your smile looks, planned with you before anything becomes
						permanent.
					</p>
					<ul class="mt-6 flex flex-col gap-2 text-sm">
						<li><a href="/porcelain-veneers/" class="text-gold-text hover:underline">Porcelain veneers</a></li>
						<li><a href="/teeth-whitening/" class="text-gold-text hover:underline">Teeth whitening</a></li>
						<li><a href="/smile-design/" class="text-gold-text hover:underline">Smile design</a></li>
						<li><a href="/invisalign/" class="text-gold-text hover:underline">Invisalign</a></li>
					</ul>
					<a href="/cosmetic-dentistry/" class="mt-6 inline-block font-semibold text-olive-deep hover:underline">
						All cosmetic services →
					</a>
				</div>
			</div>
			<div class="mt-12 text-center">
				<a href="/book/" class="inline-block rounded-lg bg-gold-text px-7 py-3.5 font-semibold text-white shadow-soft transition hover:brightness-110">
					Book a visit
				</a>
			</div>
		</section>

		<!-- ============ 6. MEET DR. STAEHLING ============ -->
		<section class="bg-base py-20">
			<div class="container-page grid gap-12 lg:grid-cols-2 lg:items-center">
				<div class="aspect-4/5 rounded-2xl bg-linear-to-br from-gold-accent/15 via-base to-olive-soft/20 shadow-soft">
					<div class="flex h-full items-end p-6">
						<span class="rounded-full bg-surface/90 px-4 py-2 text-xs font-medium text-ink-muted shadow-soft">
							Portrait of Dr. Staehling — pending
						</span>
					</div>
				</div>
				<div>
					<h2>Meet Dr. Staehling</h2>
					<blockquote class="measure mt-6 rounded-xl border border-border bg-surface p-6 shadow-soft">
						<p class="text-ink italic">
							"I tell people what I see and what it means, then I let them decide. Most of
							what looks urgent on an X-ray can actually wait, and I'd rather earn someone's
							trust over ten years than talk them into something today. If you've been putting
							this off, you won't get a lecture here — you'll get a plan."
						</p>
						<p class="mt-4 text-xs text-ink-muted/70">
							Draft quote for preview — Dr. Staehling's own words will replace this before
							launch.
						</p>
					</blockquote>
					<p class="measure mt-6 text-ink-muted">
						{business.doctor.name}, {business.doctor.credential}, owns and runs {business.name}.
						He is a member of the American Dental Association, the Academy of General
						Dentistry, the American Academy of Cosmetic Dentistry, and the North Carolina
						Dental Society.
					</p>
					<div class="mt-6 flex flex-wrap gap-6">
						<a href="/dr-ryan-staehling/" class="font-semibold text-olive-deep hover:underline">
							More about Dr. Staehling →
						</a>
						<a href="/our-team/" class="font-semibold text-olive-deep hover:underline">
							Meet the team →
						</a>
					</div>
				</div>
			</div>
		</section>

		<!-- ============ 7. SMILE GALLERY PREVIEW (placeholder tiles, real cases pending) ============ -->
		<section class="border-y border-border bg-surface py-16">
			<div class="container-page">
				<div class="text-center">
					<h2>Real results, real patients</h2>
					<p class="measure mx-auto mt-4 text-ink-muted">
						A preview of cosmetic work we've done. The cases below are placeholders — real
						before-and-after photos are on the way.
					</p>
				</div>

				<div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
					{Array.from({ length: 4 }).map((_, i) => (
						<div class="rounded-2xl border border-border bg-base p-3 shadow-soft">
							<div class="grid grid-cols-2 gap-2">
								<div class="relative aspect-4/5 overflow-hidden rounded-xl bg-linear-to-br from-olive-soft/25 via-base to-gold-accent/15">
									<div class="absolute inset-0 flex items-end p-3">
										<span class="rounded-full bg-surface/90 px-2.5 py-1 text-[11px] font-medium text-ink-muted shadow-soft">
											Before
										</span>
									</div>
								</div>
								<div class="relative aspect-4/5 overflow-hidden rounded-xl bg-linear-to-br from-gold-accent/15 via-base to-olive-soft/25">
									<div class="absolute inset-0 flex items-end p-3">
										<span class="rounded-full bg-surface/90 px-2.5 py-1 text-[11px] font-medium text-ink-muted shadow-soft">
											After
										</span>
									</div>
								</div>
							</div>
							<p class="mt-3 text-sm text-ink-muted">Before/after photos — pending</p>
						</div>
					))}
				</div>

				<div class="mt-8 text-center">
					<a href="/smile-gallery/" class="font-semibold text-olive-deep hover:underline">
						See more results →
					</a>
				</div>

				<div class="mx-auto mt-12 max-w-xl border-t border-border pt-10 text-center">
					<h3>Not sure where to start?</h3>
					<p class="measure mx-auto mt-3 text-sm text-ink-muted">
						A consultation is a conversation about what you want to change and what it would
						take to get there. No treatment happens that day.
					</p>
					<a href="/book/" class="mt-5 inline-block rounded-lg bg-gold-text px-7 py-3.5 font-semibold text-white shadow-soft transition hover:brightness-110">
						Book a consultation
					</a>
				</div>
			</div>
		</section>

		<!-- ============ 8. PATIENT VOICES ============ -->
		<section class="container-page py-20">
			<h2 class="text-center">In patients' own words</h2>
			<div class="mt-10 grid gap-6 md:grid-cols-3">
				{[
					{
						quote: "I hadn't been to a dentist in almost eight years because of how anxious it made me. Dr. Staehling didn't rush anything on my first visit — he just explained what he was seeing and let me set the pace. I actually keep my appointments now.",
						name: "Rachel M.",
					},
					{
						quote: "Our whole family has been coming here since my kids were in elementary school. They're in college now and still ask for this office when they're home for a cleaning. That kind of consistency is hard to find.",
						name: "Tom B.",
					},
					{
						quote: "I went in expecting to be told I needed a crown. Dr. Staehling said it could wait and to keep an eye on it instead. It's been two years and it's still fine. I trust what he tells me because he's never tried to sell me on anything.",
						name: "Linda K.",
					},
				].map((t) => (
					<div class="rounded-2xl border border-border bg-surface p-6 shadow-soft">
						<p class="text-ink italic">"{t.quote}"</p>
						<p class="mt-4 text-sm font-semibold text-olive-deep">— {t.name}</p>
					</div>
				))}
			</div>
			<p class="mt-8 text-center text-xs text-ink-muted/70">
				Sample patient stories for preview. Real reviews will be added before launch.
			</p>
		</section>

		<!-- ============ 9. INSURANCE & PAYMENT (blocked shell) ============ -->
		<section class="bg-olive-soft/10 py-20">
			<div class="container-page">
				<h2 class="text-center">Insurance and payment</h2>
				<div class="mx-auto mt-10 grid max-w-3xl gap-4 sm:grid-cols-2">
					{[
						{
							label: "In-network plans accepted",
							body: "Delta Dental, Cigna, Aetna, and most major PPO plans.",
						},
						{
							label: "Out-of-network policy",
							body: "We're happy to see out-of-network patients and will file claims on your behalf so you can get whatever reimbursement your plan allows.",
						},
						{
							label: "Payment options & financing",
							body: "Cash, check, all major credit cards, and financing through CareCredit for larger treatment plans.",
						},
						{
							label: "In-house membership plan",
							body: "For patients without insurance, an in-house plan covering two cleanings and exams a year, plus a discount on additional treatment.",
						},
					].map((f) => (
						<div class="rounded-xl border border-border bg-surface p-5 shadow-soft">
							<p class="text-sm font-medium text-ink">{f.label}</p>
							<p class="mt-1 text-sm text-ink-muted">{f.body}</p>
						</div>
					))}
				</div>
				<p class="mt-6 text-center text-xs text-ink-muted/70">
					Example plans shown for preview. Confirmed insurance and payment details will be
					added before launch.
				</p>
				<div class="mt-10 flex flex-col items-center gap-4">
					<a href="/insurance-and-payment/" class="font-semibold text-olive-deep hover:underline">
						Full insurance &amp; payment details →
					</a>
					<a href="/book/" class="rounded-lg bg-gold-text px-7 py-3.5 font-semibold text-white shadow-soft transition hover:brightness-110">
						Book a visit
					</a>
				</div>
			</div>
		</section>

		<!-- ============ 10. LOCATION & BOOKING ANCHOR ============ -->
		<section id="contact" class="container-page py-20">
			<h2 class="text-center">Come see us</h2>
			<div class="mt-10 grid gap-10 lg:grid-cols-2">
				<div class="rounded-2xl border border-border bg-surface p-8 shadow-soft">
					<p class="font-medium text-ink">{business.address.full}</p>
					<a href={business.phone.href} class="mt-1 block text-gold-text hover:underline">{business.phone.display}</a>

					<ul class="mt-6 flex flex-col gap-1 text-sm text-ink-muted">
						{business.hours.map((h) => (
							<li class="flex justify-between gap-4">
								<span>{h.days}</span>
								<span>{h.time}</span>
							</li>
						))}
					</ul>

					<a href={mapsHref} target="_blank" rel="noopener noreferrer" class="mt-6 inline-block font-semibold text-olive-deep hover:underline">
						Get directions →
					</a>
				</div>

				<form class="rounded-2xl border border-border bg-surface p-8 shadow-soft">
					<!-- No practice management system confirmed yet (structure.md open item);
					     this is the documented fallback request form. Submission endpoint is
					     not wired — needs a real handler before this ships. -->
					<p class="text-sm text-ink-muted">
						Prefer an embedded real-time scheduler once we know your booking system.
						Until then:
					</p>
					<div class="mt-4 grid gap-4">
						<label class="text-sm font-medium text-ink">
							Name
							<input type="text" name="name" required class="mt-1 w-full rounded-lg border border-border bg-base px-3 py-2.5 text-ink" />
						</label>
						<label class="text-sm font-medium text-ink">
							Phone
							<input type="tel" name="phone" required class="mt-1 w-full rounded-lg border border-border bg-base px-3 py-2.5 text-ink" />
						</label>
						<label class="text-sm font-medium text-ink">
							Email
							<input type="email" name="email" required class="mt-1 w-full rounded-lg border border-border bg-base px-3 py-2.5 text-ink" />
						</label>
						<label class="text-sm font-medium text-ink">
							Preferred time
							<input type="text" name="preferred-time" class="mt-1 w-full rounded-lg border border-border bg-base px-3 py-2.5 text-ink" />
						</label>
						<label class="text-sm font-medium text-ink">
							Reason for visit
							<input type="text" name="reason" class="mt-1 w-full rounded-lg border border-border bg-base px-3 py-2.5 text-ink" />
						</label>
					</div>
					<button type="submit" class="mt-6 w-full rounded-lg bg-gold-text py-3 font-semibold text-white transition hover:brightness-110">
						Request an appointment
					</button>
				</form>
			</div>
		</section>
	</main>

	<Footer />
</Layout>
