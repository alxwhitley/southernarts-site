---
import { business } from "../data/business";
---

<header id="site-header" class="sticky top-0 z-(--z-sticky) bg-base">
	<div class="hidden border-b border-border/70 bg-olive-deep text-white md:block">
		<div class="container-page flex h-9 items-center justify-between text-sm">
			<span>{business.address.full}</span>
			<span id="hours-status" data-hours-status>Hours</span>
			<a href={business.phone.href} class="font-medium hover:underline">{business.phone.display}</a>
		</div>
	</div>

	<div id="nav-scrim" class="pointer-events-none fixed inset-0 z-(--z-dropdown) hidden bg-black/5" aria-hidden="true"></div>

	<div class="container-page relative flex h-20 items-center justify-between transition-[height] duration-200" id="main-bar">
		<a href="/" class="font-heading text-xl font-semibold text-olive-deep">
			{business.name}
		</a>

		<nav aria-label="Primary" class="hidden lg:block">
			<ul class="flex items-center gap-1">
				<li class="relative">
					<button type="button" class="nav-trigger" aria-expanded="false" aria-controls="panel-about" data-panel="about">
						About
					</button>
					<div id="panel-about" class="nav-panel nav-panel-simple" hidden>
						<ul class="flex flex-col gap-1 p-3">
							<li><a href="/dr-ryan-staehling/" class="nav-panel-link">Meet Dr. Staehling</a></li>
							<li><a href="/our-team/" class="nav-panel-link">Our Team</a></li>
							<li><a href="/office-and-technology/" class="nav-panel-link">Office &amp; Technology</a></li>
						</ul>
						<div class="border-t border-border p-3">
							<a href="/about/" class="nav-panel-link">Our Practice</a>
						</div>
					</div>
				</li>

				<li class="relative">
					<button type="button" class="nav-trigger" aria-expanded="false" aria-controls="panel-cosmetic" data-panel="cosmetic">
						Cosmetic Dentistry
					</button>
					<div id="panel-cosmetic" class="nav-panel nav-panel-mega" hidden>
						<div class="grid grid-cols-4 gap-8 p-8">
							<div>
								<p class="nav-panel-heading">Popular Treatments</p>
								<ul class="flex flex-col gap-2">
									<li><a href="/porcelain-veneers/" class="nav-panel-link">Porcelain Veneers</a></li>
									<li><a href="/dental-bonding/" class="nav-panel-link">Dental Bonding</a></li>
								</ul>
							</div>
							<div>
								<p class="nav-panel-heading">Smile Transformation</p>
								<ul class="flex flex-col gap-2">
									<li><a href="/smile-design/" class="nav-panel-link">Smile Design</a></li>
									<li><a href="/invisalign/" class="nav-panel-link">Invisalign</a></li>
								</ul>
							</div>
							<div>
								<p class="nav-panel-heading">Also Offered</p>
								<ul class="flex flex-col gap-2">
									<li><a href="/teeth-whitening/" class="nav-panel-link">Teeth Whitening</a></li>
									<li><a href="/tooth-colored-fillings/" class="nav-panel-link">Tooth-Colored Fillings</a></li>
								</ul>
							</div>
							<div class="rounded-lg bg-base p-4">
								<p class="font-heading text-base font-semibold text-olive-deep">Not sure where to start?</p>
								<p class="mt-1 text-sm text-ink-muted">Book a consult and we'll talk through it together.</p>
								<a href="/book/" class="nav-panel-link mt-2 inline-block font-medium">Book a consult →</a>
							</div>
						</div>
						<div class="border-t border-border px-8 py-3">
							<a href="/cosmetic-dentistry/" class="nav-panel-link font-medium">All Cosmetic Services →</a>
						</div>
					</div>
				</li>

				<li class="relative">
					<button type="button" class="nav-trigger" aria-expanded="false" aria-controls="panel-family" data-panel="family">
						Family Care
					</button>
					<div id="panel-family" class="nav-panel nav-panel-mega" hidden>
						<div class="grid grid-cols-4 gap-8 p-8">
							<div>
								<p class="nav-panel-heading">Preventive</p>
								<ul class="flex flex-col gap-2">
									<li><a href="/dental-cleanings/" class="nav-panel-link">Cleanings &amp; Exams</a></li>
									<li><a href="/periodontal-care/" class="nav-panel-link">Periodontal Care</a></li>
									<li><a href="/night-guards-and-mouthguards/" class="nav-panel-link">Night Guards &amp; Mouthguards</a></li>
								</ul>
							</div>
							<div>
								<p class="nav-panel-heading">Restorative</p>
								<ul class="flex flex-col gap-2">
									<li><a href="/dental-crowns-and-bridges/" class="nav-panel-link">Crowns &amp; Bridges</a></li>
									<li><a href="/dental-implants/" class="nav-panel-link">Dental Implants</a></li>
									<li><a href="/root-canal-treatment/" class="nav-panel-link">Root Canal Treatment</a></li>
									<li><a href="/dentures/" class="nav-panel-link">Dentures</a></li>
									<li><a href="/tooth-colored-fillings/" class="nav-panel-link">Tooth-Colored Fillings</a></li>
								</ul>
							</div>
							<div>
								<p class="nav-panel-heading">For Children &amp; Urgent</p>
								<ul class="flex flex-col gap-2">
									<li><a href="/childrens-dentistry/" class="nav-panel-link">Children's Dentistry</a></li>
									<li>
										<a href="/emergency-dentistry/" class="nav-panel-link inline-flex items-center gap-1.5 font-medium text-gold-text">
											<span class="h-1.5 w-1.5 rounded-full bg-gold-text"></span>
											Emergency Dental Care
										</a>
									</li>
								</ul>
							</div>
							<div class="rounded-lg bg-base p-4">
								<p class="font-heading text-base font-semibold text-olive-deep">Nervous about the dentist?</p>
								<p class="mt-1 text-sm text-ink-muted">Here's how we help.</p>
								<a href="/dental-anxiety/" class="nav-panel-link mt-2 inline-block font-medium">Learn more →</a>
							</div>
						</div>
						<div class="border-t border-border px-8 py-3">
							<a href="/family-dentistry/" class="nav-panel-link font-medium">All Family &amp; Restorative Services →</a>
						</div>
					</div>
				</li>

				<li class="relative">
					<button type="button" class="nav-trigger" aria-expanded="false" aria-controls="panel-experience" data-panel="experience">
						Patient Experience
					</button>
					<div id="panel-experience" class="nav-panel nav-panel-compact" hidden>
						<div class="grid grid-cols-2 gap-6 p-6">
							<div>
								<p class="nav-panel-heading">Your Visit</p>
								<ul class="flex flex-col gap-2">
									<li><a href="/new-patient-visit/" class="nav-panel-link">Your First Visit</a></li>
									<li><a href="/dental-anxiety/" class="nav-panel-link">Dental Anxiety</a></li>
								</ul>
							</div>
							<div>
								<p class="nav-panel-heading">Practical</p>
								<ul class="flex flex-col gap-2">
									<li><a href="/patient-forms/" class="nav-panel-link">Patient Forms</a></li>
									<li><a href="/insurance-and-payment/" class="nav-panel-link">Insurance &amp; Payment</a></li>
								</ul>
							</div>
						</div>
						<div class="border-t border-border px-6 py-3">
							<a href="/patient-experience/" class="nav-panel-link font-medium">What to Expect →</a>
						</div>
					</div>
				</li>

				<li>
					<a href="/smile-gallery/" class="nav-trigger">Smile Gallery</a>
				</li>
			</ul>
		</nav>

		<div class="flex items-center gap-3">
			<a
				href="/book/"
				class="hidden rounded-lg bg-gold-text px-5 py-2.5 text-sm font-semibold text-white shadow-soft transition hover:brightness-110 lg:inline-block"
			>
				Book a Visit
			</a>
			<button
				type="button"
				id="mobile-menu-toggle"
				class="flex h-11 w-11 items-center justify-center rounded-lg text-olive-deep lg:hidden"
				aria-expanded="false"
				aria-controls="mobile-drawer"
				aria-label="Open menu"
			>
				<svg id="icon-open" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
				<svg id="icon-close" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="hidden"><path d="M6 6l12 12M18 6L6 18"/></svg>
			</button>
		</div>
	</div>

	<div
		id="mobile-drawer"
		class="fixed inset-0 top-0 z-(--z-modal) hidden flex-col bg-base lg:hidden"
		aria-label="Mobile navigation"
		aria-hidden="true"
	>
		<div class="flex h-20 items-center justify-between border-b border-border px-6">
			<span class="font-heading text-xl font-semibold text-olive-deep">{business.name}</span>
			<button type="button" id="mobile-drawer-close" class="flex h-11 w-11 items-center justify-center text-olive-deep" aria-label="Close menu">
				<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
			</button>
		</div>
		<div class="flex-1 overflow-y-auto px-6 py-4">
			<ul class="flex flex-col divide-y divide-border">
				<li>
					<button type="button" class="mobile-accordion-trigger" aria-expanded="false" data-accordion="about">
						About <span class="accordion-plus">+</span>
					</button>
					<div class="mobile-accordion-panel" hidden>
						<a href="/about/" class="mobile-accordion-link">Our Practice</a>
						<a href="/dr-ryan-staehling/" class="mobile-accordion-link">Meet Dr. Staehling</a>
						<a href="/our-team/" class="mobile-accordion-link">Our Team</a>
						<a href="/office-and-technology/" class="mobile-accordion-link">Office &amp; Technology</a>
					</div>
				</li>
				<li>
					<button type="button" class="mobile-accordion-trigger" aria-expanded="false" data-accordion="cosmetic">
						Cosmetic Dentistry <span class="accordion-plus">+</span>
					</button>
					<div class="mobile-accordion-panel" hidden>
						<a href="/cosmetic-dentistry/" class="mobile-accordion-link">All Cosmetic Services</a>
						<a href="/porcelain-veneers/" class="mobile-accordion-link">Porcelain Veneers</a>
						<a href="/teeth-whitening/" class="mobile-accordion-link">Teeth Whitening</a>
						<a href="/dental-bonding/" class="mobile-accordion-link">Dental Bonding</a>
						<a href="/smile-design/" class="mobile-accordion-link">Smile Design</a>
						<a href="/invisalign/" class="mobile-accordion-link">Invisalign</a>
					</div>
				</li>
				<li>
					<button type="button" class="mobile-accordion-trigger" aria-expanded="false" data-accordion="family">
						Family Care <span class="accordion-plus">+</span>
					</button>
					<div class="mobile-accordion-panel" hidden>
						<a href="/family-dentistry/" class="mobile-accordion-link">All Family &amp; Restorative</a>
						<a href="/emergency-dentistry/" class="mobile-accordion-link font-medium text-gold-text">Emergency Dental Care</a>
						<a href="/dental-cleanings/" class="mobile-accordion-link">Cleanings &amp; Exams</a>
						<a href="/childrens-dentistry/" class="mobile-accordion-link">Children's Dentistry</a>
						<a href="/dental-crowns-and-bridges/" class="mobile-accordion-link">Crowns &amp; Bridges</a>
						<a href="/dental-implants/" class="mobile-accordion-link">Dental Implants</a>
						<a href="/root-canal-treatment/" class="mobile-accordion-link">Root Canal Treatment</a>
						<a href="/dentures/" class="mobile-accordion-link">Dentures</a>
						<a href="/periodontal-care/" class="mobile-accordion-link">Periodontal Care</a>
						<a href="/night-guards-and-mouthguards/" class="mobile-accordion-link">Night Guards &amp; Mouthguards</a>
					</div>
				</li>
				<li>
					<button type="button" class="mobile-accordion-trigger" aria-expanded="false" data-accordion="experience">
						Patient Experience <span class="accordion-plus">+</span>
					</button>
					<div class="mobile-accordion-panel" hidden>
						<a href="/patient-experience/" class="mobile-accordion-link">What to Expect</a>
						<a href="/dental-anxiety/" class="mobile-accordion-link">Dental Anxiety</a>
						<a href="/new-patient-visit/" class="mobile-accordion-link">Your First Visit</a>
						<a href="/patient-forms/" class="mobile-accordion-link">Patient Forms</a>
						<a href="/insurance-and-payment/" class="mobile-accordion-link">Insurance &amp; Payment</a>
					</div>
				</li>
				<li class="py-3">
					<a href="/smile-gallery/" class="font-heading text-lg font-semibold text-olive-deep">Smile Gallery</a>
				</li>
			</ul>
		</div>
		<div class="flex gap-3 border-t border-border p-6">
			<a href={business.phone.href} class="flex-1 rounded-lg border border-olive-deep py-3 text-center font-semibold text-olive-deep">
				Call {business.phone.display}
			</a>
			<a href="/book/" class="flex-1 rounded-lg bg-gold-text py-3 text-center font-semibold text-white">
				Book a Visit
			</a>
		</div>
	</div>
</header>

<div
	id="mobile-bottom-bar"
	class="fixed inset-x-0 bottom-0 z-(--z-sticky) flex border-t border-border bg-surface shadow-lifted lg:hidden"
>
	<a href={business.phone.href} class="flex flex-1 items-center justify-center gap-2 border-r border-border py-3.5 font-semibold text-olive-deep">
		<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
		Call
	</a>
	<a href="/book/" class="flex flex-1 items-center justify-center gap-2 bg-gold-text py-3.5 font-semibold text-white">
		Book a Visit
	</a>
</div>

<style>
	.nav-trigger {
		display: inline-flex;
		align-items: center;
		padding: 0.6rem 0.85rem;
		border-radius: 0.5rem;
		font-size: 0.95rem;
		font-weight: 500;
		color: var(--color-ink);
		transition: color 150ms ease, background-color 150ms ease;
	}
	.nav-trigger:hover,
	.nav-trigger[aria-expanded="true"] {
		color: var(--color-olive-deep);
		background: color-mix(in oklab, var(--color-olive-soft) 12%, transparent);
	}

	.nav-panel {
		position: absolute;
		top: calc(100% + 0.5rem);
		left: 0;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: 0.75rem;
		box-shadow: var(--shadow-lifted);
		z-index: var(--z-dropdown);
		opacity: 0;
		transform: translateY(4px);
		transition: opacity 200ms ease, transform 200ms ease;
	}
	.nav-panel.is-open {
		opacity: 1;
		transform: translateY(0);
	}
	.nav-panel-simple {
		min-width: 260px;
	}
	.nav-panel-mega {
		width: min(56rem, 90vw);
	}
	.nav-panel-compact {
		width: 34rem;
	}
	.nav-panel-heading {
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.02em;
		color: var(--color-ink-muted);
		margin-bottom: 0.75rem;
	}
	.nav-panel-link {
		display: block;
		font-size: 0.9rem;
		color: var(--color-ink);
		padding: 0.15rem 0;
		transition: color 150ms ease;
	}
	.nav-panel-link:hover {
		color: var(--color-gold-text);
	}

	#nav-scrim.is-visible {
		display: block;
	}

	#main-bar.is-condensed {
		height: 4.25rem;
	}

	.mobile-accordion-trigger {
		display: flex;
		width: 100%;
		align-items: center;
		justify-content: space-between;
		padding: 1rem 0;
		font-family: var(--font-heading);
		font-size: 1.05rem;
		font-weight: 600;
		color: var(--color-olive-deep);
	}
	.accordion-plus {
		font-weight: 400;
		color: var(--color-ink-muted);
		transition: transform 200ms ease;
	}
	.mobile-accordion-trigger[aria-expanded="true"] .accordion-plus {
		transform: rotate(45deg);
	}
	.mobile-accordion-panel {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding-bottom: 1rem;
	}
	.mobile-accordion-link {
		font-size: 0.95rem;
		color: var(--color-ink);
		padding: 0.35rem 0;
	}

	@media (prefers-reduced-motion: reduce) {
		.nav-panel {
			transition: none;
		}
	}
</style>

<script>
	const ENTER_DELAY = 150;
	const EXIT_DELAY = 300;

	const triggers = Array.from(document.querySelectorAll<HTMLButtonElement>(".nav-trigger[data-panel]"));
	const scrim = document.getElementById("nav-scrim");
	let openPanelId: string | null = null;
	let enterTimer: ReturnType<typeof setTimeout> | undefined;
	let exitTimer: ReturnType<typeof setTimeout> | undefined;

	function panelFor(trigger: HTMLButtonElement) {
		return document.getElementById(trigger.dataset.panel === undefined ? "" : trigger.getAttribute("aria-controls") || "");
	}

	// Panels anchor left:0 against their trigger's <li>, which has no idea
	// where the viewport edge is. Wide panels on the later nav items
	// (mega panels especially) run off the right edge at everyday desktop
	// widths, not just small ones. Shift left only as far as needed to stay
	// inside the page's own edge margin.
	function clampPanelPosition(panel: HTMLElement) {
		const margin = 24; // container-page's 1.5rem edge padding
		panel.style.left = "0px";
		const rect = panel.getBoundingClientRect();
		const overflowRight = rect.right - (window.innerWidth - margin);
		if (overflowRight > 0) {
			panel.style.left = `-${overflowRight}px`;
		}
	}

	function openPanel(trigger: HTMLButtonElement) {
		clearTimeout(exitTimer);
		if (openPanelId && openPanelId !== trigger.id) closeAll();
		const panel = panelFor(trigger);
		if (!panel) return;
		trigger.setAttribute("aria-expanded", "true");
		panel.hidden = false;
		clampPanelPosition(panel);
		requestAnimationFrame(() => panel.classList.add("is-open"));
		scrim?.classList.add("is-visible");
		openPanelId = trigger.id || trigger.dataset.panel || null;
	}

	function closeAll() {
		triggers.forEach((trigger) => {
			trigger.setAttribute("aria-expanded", "false");
			const panel = panelFor(trigger);
			if (panel && !panel.hidden) {
				panel.classList.remove("is-open");
				setTimeout(() => {
					panel.hidden = true;
				}, 200);
			}
		});
		scrim?.classList.remove("is-visible");
		openPanelId = null;
	}

	triggers.forEach((trigger, i) => {
		if (!trigger.id) trigger.id = `nav-trigger-${i}`;

		trigger.addEventListener("mouseenter", () => {
			if (window.matchMedia("(pointer: coarse)").matches) return;
			clearTimeout(exitTimer);
			enterTimer = setTimeout(() => openPanel(trigger), ENTER_DELAY);
		});
		trigger.addEventListener("mouseleave", () => {
			clearTimeout(enterTimer);
			exitTimer = setTimeout(closeAll, EXIT_DELAY);
		});
		trigger.addEventListener("click", () => {
			if (trigger.getAttribute("aria-expanded") === "true") {
				closeAll();
			} else {
				openPanel(trigger);
			}
		});

		const panel = panelFor(trigger);
		panel?.addEventListener("mouseenter", () => clearTimeout(exitTimer));
		panel?.addEventListener("mouseleave", () => {
			exitTimer = setTimeout(closeAll, EXIT_DELAY);
		});
	});

	document.addEventListener("keydown", (e) => {
		if (e.key === "Escape" && openPanelId) {
			const active = triggers.find((t) => (t.id || t.dataset.panel) === openPanelId);
			closeAll();
			active?.focus();
		}
	});
	document.addEventListener("click", (e) => {
		const target = e.target as Node;
		const header = document.getElementById("site-header");
		if (openPanelId && header && !header.contains(target)) closeAll();
	});
	window.addEventListener("scroll", () => {
		if (openPanelId) closeAll();
		const mainBar = document.getElementById("main-bar");
		if (mainBar) mainBar.classList.toggle("is-condensed", window.scrollY > 120);
	}, { passive: true });
	window.addEventListener("resize", () => {
		if (openPanelId) closeAll();
	});

	// Mobile drawer
	const menuToggle = document.getElementById("mobile-menu-toggle");
	const drawer = document.getElementById("mobile-drawer");
	const drawerClose = document.getElementById("mobile-drawer-close");
	const iconOpen = document.getElementById("icon-open");
	const iconClose = document.getElementById("icon-close");

	const bottomBar = document.getElementById("mobile-bottom-bar");

	function openDrawer() {
		drawer?.classList.remove("hidden");
		drawer?.classList.add("flex");
		drawer?.setAttribute("aria-hidden", "false");
		menuToggle?.setAttribute("aria-expanded", "true");
		iconOpen?.classList.add("hidden");
		iconClose?.classList.remove("hidden");
		bottomBar?.classList.add("hidden");
		document.body.style.overflow = "hidden";
	}
	function closeDrawer() {
		drawer?.classList.add("hidden");
		drawer?.classList.remove("flex");
		drawer?.setAttribute("aria-hidden", "true");
		menuToggle?.setAttribute("aria-expanded", "false");
		iconOpen?.classList.remove("hidden");
		iconClose?.classList.add("hidden");
		bottomBar?.classList.remove("hidden");
		document.body.style.overflow = "";
	}
	menuToggle?.addEventListener("click", () => {
		if (drawer?.classList.contains("hidden")) openDrawer();
		else closeDrawer();
	});
	drawerClose?.addEventListener("click", closeDrawer);

	document.querySelectorAll<HTMLButtonElement>(".mobile-accordion-trigger").forEach((btn) => {
		btn.addEventListener("click", () => {
			const panel = btn.nextElementSibling as HTMLElement | null;
			const isOpen = btn.getAttribute("aria-expanded") === "true";
			document.querySelectorAll<HTMLButtonElement>(".mobile-accordion-trigger").forEach((other) => {
				other.setAttribute("aria-expanded", "false");
				const otherPanel = other.nextElementSibling as HTMLElement | null;
				if (otherPanel) otherPanel.hidden = true;
			});
			if (!isOpen && panel) {
				btn.setAttribute("aria-expanded", "true");
				panel.hidden = false;
			}
		});
	});

	// Live hours status
	function updateHoursStatus() {
		const el = document.querySelector("[data-hours-status]");
		if (!el) return;
		const now = new Date();
		const day = now.getDay(); // 0 Sun - 6 Sat
		const minutes = now.getHours() * 60 + now.getMinutes();

		const schedule: Record<number, [number, number] | null> = {
			0: null,
			1: [8 * 60, 16 * 60 + 30],
			2: [8 * 60, 16 * 60 + 30],
			3: [8 * 60, 16 * 60 + 30],
			4: [8 * 60, 16 * 60 + 30],
			5: [8 * 60, 13 * 60],
			6: null,
		};

		const today = schedule[day];
		if (today && minutes >= today[0] && minutes < today[1]) {
			const closeHour = Math.floor(today[1] / 60);
			const closeMin = today[1] % 60;
			const closeLabel = `${closeHour > 12 ? closeHour - 12 : closeHour}:${closeMin.toString().padStart(2, "0")} ${closeHour >= 12 ? "PM" : "AM"}`;
			el.textContent = `Open until ${closeLabel}`;
			return;
		}

		let nextDay = day;
		for (let i = 1; i <= 7; i++) {
			nextDay = (day + i) % 7;
			if (schedule[nextDay]) break;
		}
		const names = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];
		const openTime = schedule[nextDay]![0];
		const openHour = Math.floor(openTime / 60);
		const openLabel = `${openHour > 12 ? openHour - 12 : openHour}:00 AM`;
		el.textContent = `Closed — opens ${nextDay === (day + 1) % 7 ? names[nextDay] : names[nextDay]} ${openLabel}`;
	}
	updateHoursStatus();
</script>
