---
import { business } from "../data/business";
---

<footer class="border-t border-border bg-olive-deep pb-24 text-white lg:pb-0">
	<div class="container-page grid gap-10 py-14 md:grid-cols-4">
		<div>
			<p class="font-heading text-lg font-semibold">{business.name}</p>
			<p class="mt-3 text-sm text-white/75">{business.address.full}</p>
			<a href={business.phone.href} class="mt-1 block text-sm text-white/90 hover:underline">{business.phone.display}</a>
		</div>

		<div>
			<p class="text-xs font-semibold tracking-wide text-white/75">Visit</p>
			<ul class="mt-3 flex flex-col gap-2 text-sm">
				<li><a href="/about/" class="text-white/85 hover:text-white">About</a></li>
				<li><a href="/cosmetic-dentistry/" class="text-white/85 hover:text-white">Cosmetic Dentistry</a></li>
				<li><a href="/family-dentistry/" class="text-white/85 hover:text-white">Family Care</a></li>
				<li><a href="/smile-gallery/" class="text-white/85 hover:text-white">Smile Gallery</a></li>
			</ul>
		</div>

		<div>
			<p class="text-xs font-semibold tracking-wide text-white/75">Patients</p>
			<ul class="mt-3 flex flex-col gap-2 text-sm">
				<li><a href="/patient-experience/" class="text-white/85 hover:text-white">What to Expect</a></li>
				<li><a href="/new-patient-visit/" class="text-white/85 hover:text-white">Your First Visit</a></li>
				<li><a href="/insurance-and-payment/" class="text-white/85 hover:text-white">Insurance &amp; Payment</a></li>
				<li><a href="/contact/" class="text-white/85 hover:text-white">Contact</a></li>
			</ul>
		</div>

		<div>
			<p class="text-xs font-semibold tracking-wide text-white/75">Hours</p>
			<ul class="mt-3 flex flex-col gap-1 text-sm text-white/85">
				{business.hours.map((h) => (
					<li class="flex justify-between gap-4">
						<span>{h.days}</span>
						<span>{h.time}</span>
					</li>
				))}
			</ul>
		</div>
	</div>

	<div class="border-t border-white/10">
		<div class="container-page flex flex-col gap-3 py-6 text-xs text-white/75 md:flex-row md:items-center md:justify-between">
			<p>&copy; {new Date().getFullYear()} {business.name}. All rights reserved.</p>
			<div class="flex gap-4">
				<a href="/privacy-policy/" class="hover:text-white">Privacy Policy</a>
				<a href="/hipaa-notice/" class="hover:text-white">HIPAA Notice</a>
			</div>
		</div>
	</div>
</footer>
